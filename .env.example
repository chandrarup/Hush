# Copy this file to .env and replace the placeholder locally.
# Never commit the real token.
HUSH_TEAM_TOKEN=replace-with-a-long-random-team-token

# Local browser access. On the VM, append its current external IP.
HUSH_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Both local and VM deployments pull the same versioned Hush artifact.
HUSH_IMAGE=us-central1-docker.pkg.dev/hush-milestone-2-20260922/hush-containers/hush:v1

# Fast CPU defaults for cloud transcription. Use base.en and beam size 5 when
# higher accuracy matters more than response time.
HUSH_WHISPER_MODEL=tiny.en
HUSH_WHISPER_BEAM_SIZE=1

OLLAMA_MODEL=llama3.2:3b
