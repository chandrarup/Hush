# Milestone 4 production does not use a .env file. This file documents only
# non-secret deployment names; secret values are read from Secret Manager with
# the VM's attached service account.
GOOGLE_CLOUD_PROJECT=hush-milestone-2-20260922
HUSH_CLOUD_SQL_INSTANCE=hush-milestone-2-20260922:us-central1:hush-postgres-m4
HUSH_DB_NAME=hush
HUSH_DB_USER=hush_app
HUSH_DB_PASSWORD_SECRET=hush-db-password
HUSH_TEAM_TOKEN_SECRET=hush-team-token
HUSH_UPLOAD_BUCKET=hush-milestone-2-20260922-uploads

# The VM publishes Hush on loopback only. Reach it through an encrypted SSH or
# IAP tunnel; do not add a public IP here unless HTTPS/WSS terminates first.
HUSH_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Both local and VM deployments pull the same versioned Hush artifact.
HUSH_IMAGE=us-central1-docker.pkg.dev/hush-milestone-2-20260922/hush-containers/hush:v2.0.2

# Fast CPU defaults for cloud transcription. Use base.en and beam size 5 when
# higher accuracy matters more than response time.
HUSH_WHISPER_MODEL=tiny.en
HUSH_WHISPER_BEAM_SIZE=1

OLLAMA_MODEL=llama3.2:3b
