# ── Python ──────────────────────────────────────────────────────────────────
**/[Pp]ycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build artifacts ──────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.dmg          # built distribution packages — upload to releases, don't commit
*.app/

# ── macOS system files ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── User configuration (stays in ~/.voiceflow) ──────────────────────────────
# These are written at runtime into the user's home directory:
#   ~/.voiceflow/config.toml
#   ~/.voiceflow/.onboarded
#   ~/.voiceflow/vocab.txt
#   ~/.voiceflow/voiceflow.log

# ── Application runtime data (repo-local, never commit) ────────────────────
data/*.db
data/*.db-*

# ── Test & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
*.log

# ── Secrets (belt-and-suspenders — none currently exist, keep protected) ─────
.env
.env.*
*.secret
*.token
*.pem
*.key
secrets.toml

# ── Temp / scratch ────────────────────────────────────────────────────────────
tmp/
scratch/
