# ── Python ──────────────────────────────────────────────────────────────────
**/[Pp]ycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build artifacts ──────────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.dmg          # built distribution packages — upload to releases, don't commit
*.app/

# ── macOS system files ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── User data (kept inside the project, never committed) ─────────────────────
data/*
!data/.gitkeep

# ── Test & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.benchmarks/
.coverage
htmlcov/
*.log

# ── Secrets (belt-and-suspenders — none currently exist, keep protected) ─────
.env
.env.*
!.env.example
*.secret
*.token
*.pem
*.key
secrets.toml

# ── Temp / scratch ────────────────────────────────────────────────────────────
tmp/
scratch/
.codex-artifact/
.codex-finalizer*/
.codex-m2-build/
.codex-pptx-build/
.playwright-mcp/
